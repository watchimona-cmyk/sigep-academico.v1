{
  "name": "sigep-academico",
  "private": true,
  "version": "1.1.0",
  "description": "Sistema Integrado de Gestão Escolar Profissional",
  "author": "SIGEP-Group",
  "main": "main.cjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchimona-cmyk/sigep-academico.git"
  },
  "bugs": {
    "url": "https://github.com/watchimona-cmyk/sigep-academico/issues"
  },
  "homepage": "https://github.com/watchimona-cmyk/sigep-academico#readme",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "node --max-old-space-size=2048 node_modules/vite/bin/vite.js build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron server.js",
    "lint": "tsc --noEmit",
    "electron-dev": "concurrently \"npm run dev\" \"electron .\"",
    "package": "npm run build && electron-builder build --win --x64"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "electron-log": "^5.1.5",
    "electron-updater": "^6.1.8",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.14",
    "to-ico": "^1.1.5",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.sigep.academico",
    "productName": "SIGEP-Academico",
    "copyright": "Copyright © 2026 SIGEP-Group. Todos os direitos reservados.",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "watchimona-cmyk",
        "repo": "sigep-academico"
      }
    ],
    "files": [
      "dist/**/*",
      "main.js",
      "main.cjs",
      "preload.js",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SIGEP-Academico"
    }
  }
}
